# Environment example for Repo Risk Analyzer backend
# Path to local repository to analyze (optional). You can pass other paths via API.
REPO_PATH=

# Optional: GenAI (choose one provider style)
# LLM_PROVIDER=openai   — OpenAI-compatible chat API (Groq, OpenRouter, OpenAI). Default.
# LLM_PROVIDER=huggingface — Hugging Face Inference API (transformer models). Set URL to model endpoint.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_URL=
# For OpenAI-style: also set LLM_MODEL (e.g. gpt-4o-mini).
# For Hugging Face: set LLM_API_URL to https://api-inference.huggingface.co/models/<org>/<model>
LLM_MODEL=gpt-3.5-turbo
